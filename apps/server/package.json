{
  "name": "@highport/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/s3-request-presigner": "^3.985.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/websocket": "^8.3.0",
    "@hocuspocus/extension-database": "^2.0.0",
    "@hocuspocus/server": "^2.0.0",
    "@highport/shared": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "fastify": "^4.26.0",
    "postgres": "^3.4.0",
    "ws": "^8.19.0",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.28.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
