# Highport Server (Fastify + Hocuspocus) Configuration
# Copy to .env and fill in values. See root .env.example for overview.

# Database connection URL (required)
# For local development with Docker (host port 18123 → container port 5432):
DATABASE_URL=postgresql://highport:highport_dev@localhost:18123/highport_test

# RAG service URL (optional, used by portrait generation and document routes)
RAG_SERVICE_URL=http://localhost:18124

# Portrait storage backend (optional, defaults to local filesystem)
# Options: local | s3
PORTRAIT_STORAGE_TYPE=local

# Local filesystem path for portrait storage (required if PORTRAIT_STORAGE_TYPE=local)
PORTRAIT_STORAGE_PATH=./data/portraits

# === S3 Storage (required only if PORTRAIT_STORAGE_TYPE=s3) ===
# PORTRAIT_S3_BUCKET=
# PORTRAIT_S3_REGION=us-east-1
# PORTRAIT_S3_ENDPOINT=  # Optional, for S3-compatible storage (R2, MinIO, etc.)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
