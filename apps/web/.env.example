# Highport Web (Next.js 14) Configuration
# Copy to .env and fill in values. See root .env.example for overview.

# WebSocket Server URL (Hocuspocus) — read by lib/sync.ts
NEXT_PUBLIC_WS_URL=ws://localhost:18121

# REST API URL (Fastify) — read by apps/web/auth.ts and register page
NEXT_PUBLIC_API_URL=http://localhost:18122

# RAG service URL (Python FastAPI, optional) — read by lib/rag-client.ts
# Leave unset to disable AI chat features gracefully.
NEXT_PUBLIC_RAG_URL=http://localhost:18124

# RAG service URL (alternate, used by chargen narrative + connection suggestions)
# Read by lib/chargen/narrative.ts and components/chargen/ConnectionSuggestions.tsx
NEXT_PUBLIC_RAG_SERVICE_URL=http://localhost:18124

# Server URL for portrait/conflict features — read by 4 portrait/conflict components
NEXT_PUBLIC_SERVER_URL=http://localhost:18122

# Authentication secret for NextAuth.js v5 (required)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (Note: avoid `npx auth secret` — that resolves to the Better Auth CLI, not NextAuth.)
AUTH_SECRET=
