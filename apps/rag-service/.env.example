# Highport RAG Service Configuration
# Copy this file to .env and fill in your values.
# Full setup guide: ../../docs/rag-setup.md

# ==============================================================================
# LLM Provider Configuration
# ==============================================================================
# Options: ollama (free, local) or gemini (cloud, requires API key)
LLM_PROVIDER=ollama

# Ollama settings (free, local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google Gemini settings (cloud, requires API key from https://aistudio.google.com/app/apikey)
# Uncomment and fill in to use Gemini instead of Ollama
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image  # Used by portrait generation

# OpenAI API key (REQUIRED — used by providers/embeddings.py for text-embedding-ada-002)
# See docs/rag-setup.md "Current Limitation: Embeddings" for why this is needed.
# Future versions will support local embeddings; for now OpenAI is required.
OPENAI_API_KEY=sk-...your-openai-api-key-here...

# ==============================================================================
# Vector Database Provider Configuration
# ==============================================================================
# Options: chroma (free, local) or pinecone (cloud, requires API key)
VECTORDB_PROVIDER=chroma

# ChromaDB settings (free, local, no API key needed)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=highport

# Pinecone settings (cloud, requires API key from https://app.pinecone.io/)
# Uncomment and fill in to use Pinecone instead of ChromaDB
# PINECONE_API_KEY=your-pinecone-api-key-here
# PINECONE_INDEX_NAME=highport-index
# PINECONE_ENVIRONMENT=us-east-1-aws
