# Highport RAG Service Configuration
# Copy this file to .env and fill in your values.
# Full setup guide: ../../docs/rag-setup.md

# ==============================================================================
# LLM Provider Configuration
# ==============================================================================
# Options: ollama (free, local) or gemini (cloud, requires API key)
LLM_PROVIDER=ollama

# Ollama settings (free, local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google Gemini settings (cloud, requires API key from https://aistudio.google.com/app/apikey)
# Uncomment and fill in to use Gemini instead of Ollama. Portrait image generation
# requires LLM_PROVIDER=gemini; with Ollama, portrait images are disabled gracefully.
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image  # Used by portrait image generation

# ==============================================================================
# Embeddings Provider Configuration
# ==============================================================================
# Embeddings provider: "ollama" (default, free, local) or "openai" (paid, cloud)
EMBEDDINGS_PROVIDER=ollama

# Ollama embeddings model (used when EMBEDDINGS_PROVIDER=ollama)
# Default: qwen3-embedding:0.6b (1024-dim, Apache-2.0, 639MB on disk)
# Alternatives: nomic-embed-text (768-dim, smaller), bge-m3 (1024-dim, multilingual)
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# OpenAI embeddings model (used when EMBEDDINGS_PROVIDER=openai)
# Default: text-embedding-3-small (1536-dim, $0.02/1M tokens, MRL-capable)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimension override (optional)
# If unset, derives from provider: ollama=1024, openai=1536
# Set this ONLY if you want Matryoshka truncation (e.g., 768, 512, 256)
# MUST match the dimension your vector index was created with
# EMBEDDING_DIM=1024

# OpenAI API key — required ONLY when EMBEDDINGS_PROVIDER=openai
# Uncomment and fill in if you use OpenAI embeddings
# OPENAI_API_KEY=sk-...your-openai-api-key-here...

# ==============================================================================
# Vector Database Provider Configuration
# ==============================================================================
# Options: chroma (free, local) or pinecone (cloud, requires API key)
VECTORDB_PROVIDER=chroma

# ChromaDB settings (free, local, no API key needed)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=highport

# Pinecone settings (cloud, requires API key from https://app.pinecone.io/)
# Uncomment and fill in to use Pinecone instead of ChromaDB
# PINECONE_API_KEY=your-pinecone-api-key-here
# PINECONE_INDEX_NAME=highport-index
# PINECONE_ENVIRONMENT=us-east-1-aws
