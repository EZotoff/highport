{
  "name": "@highport/mgt2e",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./types/*": "./dist/types/*.js",
    "./data/*": "./dist/data/*.js",
    "./tables/*": "./dist/tables/*.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ],
      "types/*": [
        "./dist/types/*"
      ],
      "data/*": [
        "./dist/data/*"
      ],
      "tables/*": [
        "./dist/tables/*"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "../../apps/server/node_modules/.bin/vitest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "eslint": "^8.56.0"
  }
}
