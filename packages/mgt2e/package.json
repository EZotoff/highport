{
  "name": "@planeshift/mgt2e",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./types/*": "./dist/types/*.js",
    "./data/*": "./dist/data/*.js",
    "./tables/*": "./dist/tables/*.js"
  },
  "typesVersions": {
    "*": {
      "*": ["./dist/*"],
      "types/*": ["./dist/types/*"],
      "data/*": ["./dist/data/*"],
      "tables/*": ["./dist/tables/*"]
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "eslint": "^8.56.0"
  }
}
