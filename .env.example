# Vercel Deployment Environment Variables
# Copy these to your Vercel project settings and provide actual values

# WebSocket server URL (Hocuspocus)
# Example: https://your-hocuspocus-server.com or https://api.yourdomain.com
NEXT_PUBLIC_HOCUSPOCUS_URL=https://your-hocuspocus-server.com

# REST API server URL (Fastify)
# Example: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# RAG service URL (Python FastAPI)
# Example: https://rag.yourdomain.com or https://ai.yourdomain.com
# Optional: Only required if using AI chat features
NEXT_PUBLIC_RAG_URL=https://rag.yourdomain.com

# Authentication secret for NextAuth.js
# Generate with: npx auth secret
AUTH_SECRET=your-auth-secret-here
